# Server listening address (or inject PORT for PaaS runtimes)
LISTEN_ADDR=:8090
# Append-only NDJSON segment file for durable cold storage (relative works locally, /data works in Docker/K8s)
NDJSON_PATH=./logs.ndjson
# Binary CRC32 Write-Ahead Log file with checkpoint compaction
WAL_PATH=./logs.wal
# Shared API key protecting /v1/* and /metrics* endpoints (generate with: openssl rand -hex 24)
INGEST_API_KEY=replace_with_random_32byte_api_key
